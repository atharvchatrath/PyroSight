# PyroSight helmet HUD — Chromium kiosk on the monocular OLED display.
# The display connects over micro-HDMI; the helmet cage + combiner optics
# relay it to the eye. The launcher script resolves the Chromium binary name
# (which differs between Pi OS releases) and waits for the UI to be ready.
[Unit]
Description=PyroSight helmet HUD (kiosk)
After=graphical.target pyrosight-frontend.service
Wants=pyrosight-frontend.service

[Service]
Type=simple
User=pyrosight
Environment=DISPLAY=:0
Environment=PYROSIGHT_UI_PORT=3100
ExecStart=/opt/pyrosight/deploy/hud-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
